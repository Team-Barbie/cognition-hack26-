# Copy this file to .env for local development. Never put real secrets here.
# Only the coding worker uses your Codex login; run `codex login` before using it.
# Optional: AR_CODEX_BIN=C:\path\to\codex.exe
# OPENAI_API_KEY configures research/literature when using --provider openai.
OPENAI_API_KEY=replace-with-an-openai-project-key
# Demo/workflow tests use this inexpensive model; normal research keeps its configured model.
STUDIO_TEST_MODEL=gpt-5.6-terra
STUDIO_PASSWORD=replace-with-a-separate-strong-studio-password
